FROM php:8.4-cli

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    libpq-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Instalar extensiones de PHP requeridas
RUN docker-php-ext-install \
    pdo_pgsql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    sockets \
    && pecl install redis \
    && docker-php-ext-enable redis

# Obtener Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar directorio de trabajo
WORKDIR /var/www/html

# Exponer el puerto de RoadRunner (Octane)
EXPOSE 8000

# En dev, el código se monta como volumen.
# El entrypoint descarga RoadRunner si no existe y lanza Octane en modo watch.
CMD sh -c "[ -f vendor/bin/rr ] || composer run-script post-autoload-dump; \
           [ -f rr ] || vendor/bin/rr get-binary -n; \
           php artisan octane:start --server=roadrunner --host=0.0.0.0 --port=8000 --watch"
